#!/bin/sh
# Block committing secrets / malware-planted env files.
# Enable once per clone: git config core.hooksPath .githooks

blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)

if [ -n "$blocked" ]; then
  echo "ERROR: refusing to commit env secret files:" >&2
  echo "$blocked" >&2
  echo "Remove them from the index: git rm --cached -- <file>" >&2
  echo ".env is gitignored; never use git add -f .env" >&2
  exit 1
fi

exit 0
