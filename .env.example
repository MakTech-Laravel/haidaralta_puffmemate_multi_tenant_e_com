APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=
DB_SSLMODE=prefer

# Path to pg_dump/psql binaries (production image: /usr/bin after postgresql-client-18).
# Windows local example: C:/Program Files/PostgreSQL/18/bin (use forward slashes).
POSTGRES_BINARY_PATH=

# Optional Spatie backup zip encryption + mail notifications (empty = no mail channels).
BACKUP_ARCHIVE_PASSWORD=
BACKUP_MAIL_TO=
# Retention for backup:clean / "Clean old backups" (hard delete older than keep-all window).
BACKUP_KEEP_ALL_DAYS=7
BACKUP_KEEP_DAILY_DAYS=0
BACKUP_KEEP_WEEKLY_WEEKS=0
BACKUP_KEEP_MONTHLY_MONTHS=0
BACKUP_KEEP_YEARLY_YEARS=0
# After age cleanup, trim oldest until under this MB (empty = unlimited).
BACKUP_MAX_STORAGE_MB=5000

# Activity log (default true). Set false only to pause site-wide auditing.
ACTIVITYLOG_ENABLED=true

SESSION_DRIVER=database
SESSION_CONNECTION=
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local

# External Reverb Coolify app (do not install laravel/reverb in this image).
# Credentials must match the Reverb server. Production hosts:
#   APP_URL=https://puffmemate.maktechlaravel.cloud
#   REVERB_HOST=ws.puffmemate.maktechlaravel.cloud
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=ws.puffmemate.maktechlaravel.cloud
REVERB_PORT=443
REVERB_SCHEME=https

# Full origin URLs for HTTP CORS (broadcasting/auth). Not bare hostnames.
FRONTEND_URL="${APP_URL}"
CORS_ALLOWED_ORIGINS="${APP_URL}"

# Vite build-time (Coolify Dockerfile ARGs). Must expand at npm run build.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Local/dev: QUEUE_CONNECTION=database (or sync) — remote Redis queue RTT breaks
# login/Inertia (Telescope + delayed jobs use the default queue connection).
# Production Coolify: QUEUE_CONNECTION=redis and Horizon consumes default+scout.
# Do not run queue:work alongside Horizon on the same queues.
QUEUE_CONNECTION=database
QUEUE_NAMES=default,scout
QUEUE_SLEEP=3
QUEUE_TRIES=3
QUEUE_TIMEOUT=600
QUEUE_MAX_TIME=3600
QUEUE_MEMORY=128
QUEUE_PROCESSES=2
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default
REDIS_QUEUE_RETRY_AFTER=660
REDIS_QUEUE_BLOCK_FOR=5

# Horizon (production Redis only — needs ext-pcntl/posix in the Linux image)
HORIZON_PREFIX=puffmemate_horizon:
HORIZON_PATH=horizon
# Optional long-wait alerts (falls back to BACKUP_MAIL_TO when empty)
HORIZON_MAIL_TO=

# Pulse (DB ingest; phpunit forces PULSE_ENABLED=false)
PULSE_ENABLED=true
PULSE_PATH=pulse

# Local/dev against a remote Redis: prefer CACHE_STORE=database (or file/array)
# and SESSION_DRIVER=database. Production Coolify: CACHE_STORE=redis +
# SESSION_DRIVER=redis + SESSION_CONNECTION=cache.
CACHE_STORE=database
CACHE_PREFIX=puffmemate_cache_

MEMCACHED_HOST=127.0.0.1

# Prefer discrete host/user/password/port + REDIS_DB / REDIS_CACHE_DB.
# Do NOT set a single REDIS_URL=.../0 for both connections — Laravel's
# default and cache connections both read REDIS_URL, so /0 would force
# cache onto DB 0 and collide with queues.
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=redis
REDIS_USERNAME=
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Scout + external Meilisearch (server-only key — never VITE_*)
SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=puffmemate_
SCOUT_QUEUE=true
SCOUT_QUEUE_CONNECTION=redis
SCOUT_QUEUE_NAME=scout
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebase Admin (server) — mount JSON at runtime; never commit the file.
# Path relative to project root (Kreait laravel-firebase).
FIREBASE_CREDENTIALS=storage/app/firebase-credentials.json
FIREBASE_PROJECT_ID=

# Firebase Web (public — Coolify Dockerfile VITE_FIREBASE_* ARGs at build time)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# When true, a driver may have only one active branch at a time (transfer).
# When false, a driver may be active on multiple branches at once.
DRIVER_SINGLE_ACTIVE_BRANCH=true

# When true, the FCM service worker also calls showNotification (can duplicate Chrome's auto toast for notification payloads).
FCM_SW_SHOW_NOTIFICATION=false

# PWA: one product name in every environment (defaults to APP_NAME). Set false to
# serve an unregistering service worker (incident kill-switch).
PWA_NAME="${APP_NAME}"
PWA_SHORT_NAME="${APP_NAME}"
PWA_SW_ENABLED=true

# Force error-boundary debug UI on/off (unset = follow Vite DEV). Values: true|false|1|0
# VITE_ERROR_BOUNDARY_DEBUG=true

# Telescope (local/staging only — never enable in production without an explicit opt-in).
# With QUEUE_CONNECTION=redis against a remote Redis host, Telescope delayed jobs make
# every request (including login) wait on Redis RTT / timeouts. Prefer false locally
# unless QUEUE_CONNECTION is database/sync.
TELESCOPE_ENABLED=false
